{% extends 'base.html.twig' %}

{% block title %}View invoice document{% endblock %}

{% block body %}
    <h1>{{ document.originalFilename }}</h1>

    {% set sourceUrl = path('invoice_document_source', { id: document.id }) %}

    {% if document.mimeType == 'application/pdf' %}
        <iframe
            src="{{ sourceUrl }}"
            width="100%"
            height="800"
            title="{{ document.originalFilename }}"
        ></iframe>
    {% elseif document.mimeType starts with 'image/' %}
        <img
            src="{{ sourceUrl }}"
            alt="{{ document.originalFilename }}"
        >
    {% endif %}

    <p>
        <a href="{{ path('invoice_document_index') }}">
            Back to invoice documents
        </a>
    </p>
{% endblock %}
