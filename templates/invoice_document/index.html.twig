{% extends 'base.html.twig' %}

{% block title %}Invoice Documents{% endblock %}

{% block body %}
    <h1>Invoice Documents</h1>

    {% for message in app.flashes('success') %}
        <div>
            {{ message }}
        </div>
    {% endfor %}

    <table>
        <thead>
            <tr>
                <th>Filename</th>
                <th>Type</th>
                <th>Uploaded</th>
                <th>State</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            {% for document in documents %}
                <tr>
                    <td>{{ document.originalFilename }}</td>
                    <td>{{ document.mimeType }}</td>
                    <td>{{ document.uploadedAt|date('Y-m-d H:i:s') }}</td>
                    <td>{{ document.state.label }}</td>
                    <td>
                        <a href="{{ path('invoice_document_show', { id: document.id }) }}">
                            View
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3">No invoice documents have been uploaded yet.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
